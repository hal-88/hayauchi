{
  "rules": {
    ".read": false,
    ".write": false,
    "ranking": {
      "sixty": {
        ".read": "auth != null",
        "$key": {
          ".write": "auth != null && $key.beginsWith(auth.uid + '_') && $key.length <= 160",
          ".validate": "newData.hasChildren(['name', 'ninja', 'words', 'keys', 'at']) && (!data.exists() || newData.child('words').val() > data.child('words').val() || (newData.child('words').val() === data.child('words').val() && newData.child('keys').val() > data.child('keys').val()))",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
          },
          "ninja": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "costume": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "words": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150"
          },
          "keys": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "miss": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "jugemu": {
        ".read": "auth != null",
        "$key": {
          ".write": "auth != null && $key.beginsWith(auth.uid + '_') && $key.length <= 160",
          ".validate": "newData.hasChildren(['name', 'ninja', 'ms', 'at']) && (!data.exists() || newData.child('ms').val() < data.child('ms').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
          },
          "ninja": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "costume": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "ms": {
            ".validate": "newData.isNumber() && newData.val() >= 10000 && newData.val() <= 3600000"
          },
          "miss": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[0-9]{4}$/) && (!data.exists() || data.child('meta/createdAt').val() < now - 21600000 || (!newData.exists() && data.child('members/' + auth.uid).exists()))",
        ".validate": "newData.hasChild('meta')",
        "meta": {
          ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['host', 'createdAt', 'status', 'target'])",
          "host": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (newData.val() === data.val() || (newData.val() >= now - 60000 && newData.val() <= now + 60000 && (!data.exists() || data.val() < now - 21600000)))"
          },
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'done'"
          },
          "target": {
            ".validate": "newData.val() === 5 || newData.val() === 10"
          },
          "hard": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('rooms/' + $code + '/meta/status').val() === 'lobby')",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
            },
            "ninja": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "costume": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "nj": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "left": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "game": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          ".validate": "newData.hasChildren(['round', 'key', 'word', 'showAt'])",
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
          },
          "key": {
            ".validate": "newData.isString() && newData.val().length <= 6"
          },
          "showAt": {
            ".validate": "newData.isNumber()"
          },
          "word": {
            ".validate": "newData.hasChildren(['text', 'kana'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "kana": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "rounds": {
          "$r": {
            "winner": {
              ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && $r === root.child('rooms/' + $code + '/game/key').val()",
              ".validate": "newData.child('uid').val() === auth.uid || newData.child('skip').val() === true",
              "uid": {
                ".validate": "newData.isString()"
              },
              "skip": {
                ".validate": "newData.val() === true"
              },
              "out": {
                ".validate": "newData.val() === true"
              },
              "pts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "bonus": {
                ".validate": "newData.val() === 1"
              },
              "kd": {
                ".validate": "newData.val() === true"
              },
              "ms": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600000"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "wall": {
                ".validate": "newData.isString() && root.child('rooms/' + $code + '/members/' + newData.val()).exists()"
              },
              "steal": {
                ".validate": "newData.isString() && root.child('rooms/' + $code + '/members/' + newData.val()).exists()"
              },
              "shurikenTo": {
                ".validate": "newData.isString() && root.child('rooms/' + $code + '/members/' + newData.val()).exists()"
              },
              "$other": {
                ".validate": false
              }
            },
            "jutsu": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && $r === root.child('rooms/' + $code + '/game/key').val()",
                ".validate": "newData.hasChildren(['id', 'at']) && newData.child('id').isString() && newData.child('id').val().length <= 20 && newData.child('at').isNumber()"
              }
            },
            "nj": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && $r === root.child('rooms/' + $code + '/game/key').val()",
                ".validate": "newData.hasChildren(['id', 'at']) && newData.child('id').isString() && newData.child('id').val().length <= 20 && newData.child('at').isNumber()"
              }
            },
            "second": {
              ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && $r === root.child('rooms/' + $code + '/game/key').val()",
              ".validate": "newData.child('uid').val() === auth.uid && newData.child('pts').val() === 1"
            },
            "stamp": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
                ".validate": "newData.hasChildren(['s', 'at']) && newData.child('s').isNumber() && newData.child('s').val() >= 0 && newData.child('s').val() <= 5 && newData.child('at').isNumber()"
              }
            },
            "out": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
                ".validate": "newData.val() === true"
              }
            },
            "prog": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              }
            }
          }
        }
      }
    }
  }
}
